 set healthy { type mark; elements = { 0x00010000, 0x00020000, 0x00030000, 0x00040000, 0x00050000 }; }
 set bulk4 { type ipv4_addr; flags interval; }
 set bulk_dns4 { type ipv4_addr; flags timeout; timeout 6h; size 4096; }
 set sticky_w1 { type ipv4_addr . ipv4_addr; flags dynamic,timeout; timeout 30m; size 16384; }
 set sticky_w2 { type ipv4_addr . ipv4_addr; flags dynamic,timeout; timeout 30m; size 16384; }
 set sticky_w3 { type ipv4_addr . ipv4_addr; flags dynamic,timeout; timeout 30m; size 16384; }
 set sticky_w4 { type ipv4_addr . ipv4_addr; flags dynamic,timeout; timeout 30m; size 16384; }
 set sticky_w5 { type ipv4_addr . ipv4_addr; flags dynamic,timeout; timeout 30m; size 16384; }
 chain bulk { numgen random mod 300 vmap @buckets; }
 chain choose {
  ct mark & 0x00ff0000 == 0 numgen random mod 300 vmap @buckets comment "rp-equal-per-connection"
 }
 chain from_lan {
  type filter hook prerouting priority -160; policy accept;
  meta nfproto != ipv4 return
  iifname != "br-lan" return
  ip daddr { 192.168.50.0/24, 224.0.0.0/4, 255.255.255.255 } return
  fib daddr type local return
  ct state new ct mark & 0x00ff0000 == 0 jump choose
  ct state new ct mark & 0x00ff0000 == 0 counter reject with icmp type net-unreachable
  ct mark & 0x00ff0000 != 0 meta mark set (meta mark & 0xff00ffff) | (ct mark & 0x00ff0000)
 }
 chain local_output {
  type route hook output priority -160; policy accept;
  meta nfproto != ipv4 return
  ip daddr { 127.0.0.0/8, 192.168.50.0/24, 224.0.0.0/4, 255.255.255.255 } return
  fib daddr type local return
  ct mark & 0x00ff0000 != 0 meta mark set (meta mark & 0xff00ffff) | (ct mark & 0x00ff0000) return
  ct state new meta mark & 0x00ff0000 != 0 ct mark set (ct mark & 0xff00ffff) | (meta mark & 0x00ff0000) return
  ct state new oifname "rpwan1" ct mark set (ct mark & 0xff00ffff) | 0x00010000
  ct state new oifname "rpwan2" ct mark set (ct mark & 0xff00ffff) | 0x00020000
  ct state new oifname "rpwan3" ct mark set (ct mark & 0xff00ffff) | 0x00030000
  ct state new oifname "rpwan4" ct mark set (ct mark & 0xff00ffff) | 0x00040000
  ct state new oifname "rpwan5" ct mark set (ct mark & 0xff00ffff) | 0x00050000
 }
 chain forwarding_counters {
  type filter hook forward priority -5; policy accept;
  iifname "br-lan" oifname "rpwan1" ct mark & 0x00ff0000 == 0x00010000 counter comment "WAN1 marked LAN egress"
  iifname "br-lan" oifname "rpwan2" ct mark & 0x00ff0000 == 0x00020000 counter comment "WAN2 marked LAN egress"
  iifname "br-lan" oifname "rpwan3" ct mark & 0x00ff0000 == 0x00030000 counter comment "WAN3 marked LAN egress"
  iifname "br-lan" oifname "rpwan4" ct mark & 0x00ff0000 == 0x00040000 counter comment "WAN4 marked LAN egress"
  iifname "br-lan" oifname "rpwan5" ct mark & 0x00ff0000 == 0x00050000 counter comment "WAN5 marked LAN egress"
 }
}
